# Inkloom BrandLens Environment Variables Example
# Copy this to .env for local testing (NEVER commit .env to Git)

# Optional LLM API Key (Either Gemini or Anthropic)
# Get a free Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: choose the Gemini model (Google retires models, check AI Studio)
GEMINI_MODEL=gemini-2.5-flash

# Or Anthropic Claude API Key:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: Supabase persistence (Leave blank to use localStorage fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
